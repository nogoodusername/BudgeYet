# Environment Configuration for fam-ex Backend

# Application Settings
PROJECT_NAME="fam-ex Backend"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration Choice: 'sqlite' or 'postgres'
DATABASE_TYPE=sqlite

# SQLite Configuration (Used when DATABASE_TYPE=sqlite)
SQLITE_DB_FILE=./data/fam_ex.db

# PostgreSQL / Supabase / Aiven Configuration (Used when DATABASE_TYPE=postgres)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-generate-a-real-password
POSTGRES_DB=fam_ex
POSTGRES_SSL=false

# Security / Auth Settings
SECRET_KEY=change-this-super-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - comma-separated list of allowed origins (Web target only; set to your real domain(s) in production)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000
