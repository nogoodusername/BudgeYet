# root gitignore for fam-ex monorepo

# Build outputs & IDEs
.idea/
.vscode/
*.swp
*.DS_Store
.gradle/
build/
**/build/
.bin/

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python / FastAPI backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/
.coverage
htmlcov/
*.sqlite
*.db
backend/data/*.db
backend/data/*.sqlite

# Android / Kotlin / Gradle
*.apk
*.aar
*.keystore
local.properties
.navigation/
captures/
.externalNativeBuild/
.cxx/

# iOS / Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
xcuserdata/
DerivedData/
*.app
*.ipa

# Node / Wasm Web outputs
node_modules/
dist/
wasm/
