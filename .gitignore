# root gitignore for budge-yet monorepo

# Build outputs & IDEs
.idea/
.vscode/
*.swp
*.DS_Store
.gradle/
build/
**/build/
.bin/
release-artifacts/
**/release-artifacts/

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python / FastAPI backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/
.coverage
htmlcov/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
backend/data/
*.egg-info/

# Android / Kotlin / Gradle
*.apk
*.aar
*.jks
*.keystore
keystore.properties
local.properties
.navigation/
captures/
.externalNativeBuild/
.cxx/

# iOS / Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
xcuserdata/
DerivedData/
*.app
*.ipa

# Node / Wasm Web outputs
node_modules/
dist/
wasm/
kotlin-js-store/

# Cloudflare Pages
.wrangler/
