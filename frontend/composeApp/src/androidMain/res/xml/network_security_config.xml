<?xml version="1.0" encoding="utf-8"?>
<!--
    Scoped cleartext allowance for local self-hosted dev/testing (Backend Configuration's
    "Custom URL" option) — 10.0.2.2 is the Android Emulator's alias for the host loopback
    interface, and 127.0.0.1/localhost cover a physical device on adb reverse or a device-local
    server. Everything else (the hosted default, any real self-hosted domain) still requires
    HTTPS, matching the base config's default (cleartextTrafficPermitted defaults to false).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
